# ====================================================================
# FAUST STORE - ADMIN CREDENTIALS CONFIGURATION
# ====================================================================
# Salin file ini menjadi .env di komputer lokal kamu.
# Di Vercel, masukkan variabel-variabel ini pada menu:
# Project Settings > Environment Variables

# Username untuk login ke /admin/login
VITE_ADMIN_USERNAME=admin

# Password admin
VITE_ADMIN_PASSWORD=admin_faust_2026!

# (Opsional) Jika ingin keamanan ekstra menggunakan SHA-256 Hash langsung:
# Hash di bawah adalah hasil SHA-256 dari 'admin_faust_2026!'
# VITE_ADMIN_PASSWORD_HASH=01e3b6a95e0c52eb9e4f55928f6424e6c4667a421efc0a76efc255ecfa8881ad
